# HTTP Basic Authentication
HTTP_AUTH_USERNAME=admin
HTTP_AUTH_PASSWORD=changeme

# Server Configuration
# Cloud Run injects PORT automatically; HTTP_PORT is the fallback for local use.
HTTP_PORT=8080

# Enable verbose (debug) logging
DEBUG=false

# Database Configuration
DATABASE_PATH=database/bookmarks.db

# SQLite durability settings.
# Defaults are crash-safe on a gcsfuse-backed volume (e.g. Cloud Run) where the
# instance can be killed at any time:
#   SQLITE_JOURNAL_MODE      TRUNCATE keeps an on-disk journal for crash recovery
#                            (WAL is unsafe on gcsfuse; MEMORY loses data on crash).
#   SQLITE_SYNCHRONOUS       FULL fsync()s each commit, flushing it to Cloud Storage.
#   SQLITE_SINGLE_CONNECTION true avoids gcsfuse "last write wins" corruption.
# On a local/persistent disk you may set SQLITE_JOURNAL_MODE=WAL,
# SQLITE_SYNCHRONOUS=NORMAL and SQLITE_SINGLE_CONNECTION=false for more throughput.
SQLITE_JOURNAL_MODE=TRUNCATE
SQLITE_SYNCHRONOUS=FULL
SQLITE_SINGLE_CONNECTION=true

# Favicon Cache
FAVICON_CACHE_DIR=web/static/favicons

# Maximum total seconds spent discovering a favicon when saving a bookmark.
# Caps how long a save can block when a site has no (or a slow) favicon.
FAVICON_TIMEOUT=8

# Rate Limiting (requests per minute per client IP)
RATELIMIT_PER_MINUTE=100

# Optional random secret (a random one is generated if unset)
# SECRET_KEY=change-me
